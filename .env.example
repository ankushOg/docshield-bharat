# DocShield Environment Variables Template (.env.example)
# Copy this file to `.env` for local development:
#   cp .env.example .env
# NEVER commit your actual `.env` file to GitHub!

# 1. Flask Application Security
FLASK_SECRET_KEY=replace-with-a-random-32-char-secret-string
FLASK_DEBUG=true
MAX_UPLOAD_MB=10

# 2. Supabase PostgreSQL Connection URI (Transaction Pooler port 6543 or Session Pooler 5432)
# Leave empty during offline local testing to use the automatic SQLite fallback (docshield_local.db).
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# 3. Supabase Private Storage Configuration
# Create a PRIVATE bucket named `documents-private` in Supabase Storage -> Buckets.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_BUCKET=documents-private
SIGNED_URL_EXPIRY_SECONDS=3600

# 4. Optional Custom Path to Tesseract Binary (Only needed on Windows if not in PATH)
# Example on Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
